# Copy file này thành .env rồi điền giá trị thật khi chạy local.
# KHÔNG commit file .env.

PORT=8000
ENVIRONMENT=development

# Bắt buộc: API key client phải gửi trong header X-API-Key
AGENT_API_KEY=dev-key

# Redis dùng cho rate limit + cost guard
REDIS_URL=redis://localhost:6379/0

# Giới hạn request / phút cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Ngân sách chi phí LLM mỗi ngày (USD)
DAILY_BUDGET_USD=1.0
